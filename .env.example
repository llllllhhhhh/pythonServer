APP_NAME=学徒行 API
ENVIRONMENT=production
APP_VERSION=1.1.0
BUILD_COMMIT=replace-with-git-commit
API_PREFIX=/api/v1
APP_SECRET_KEY=replace-with-at-least-32-random-characters
WECHAT_MINI_APP_ID=wx22a3637008b4f8b4
WECHAT_MINI_APP_SECRET=请填写微信小程序AppSecret
# 微信支付 API v3（真实支付最低 0.01 元）
WECHAT_MCH_ID=请填写微信支付商户号
WECHAT_API_V3_KEY=请填写32位APIv3密钥
WECHAT_NOTIFY_URL=https://你的域名/api/v1/commerce/wechat/notify
WECHAT_MERCHANT_SERIAL_NO=请填写商户API证书序列号
WECHAT_MERCHANT_PRIVATE_KEY_PATH=/run/secrets/xuetuxing/apiclient_key.pem
WECHAT_PAY_PUBLIC_KEY_ID=请填写PUB_KEY_ID开头的微信支付公钥ID
WECHAT_PAY_PUBLIC_KEY_PATH=/run/secrets/xuetuxing/wechatpay_pub.pem
ASSET_URL_TTL_SECONDS=900

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=xuetuxing
MYSQL_PASSWORD=请填写数据库密码
MYSQL_DATABASE=xuetuxing

# Docker Compose 使用独立变量，避免复用上面的本机 MySQL 连接配置。
COMPOSE_MYSQL_ROOT_PASSWORD=请填写容器数据库 root 密码
COMPOSE_MYSQL_USER=xuetuxing
COMPOSE_MYSQL_PASSWORD=请填写容器数据库应用账号密码
COMPOSE_MYSQL_DATABASE=xuetuxing

# 仅用于首次接管没有 alembic_version 的旧数据库；生产环境完成后应恢复为 false。
ALLOW_LEGACY_SCHEMA_ADOPTION=false

REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0

# 只有请求的 TCP 对端在此 IP/CIDR 列表中时，才会信任 X-Forwarded-For/X-Real-IP。
# Docker 内网请按实际网段配置，不要使用 0.0.0.0/0。
TRUSTED_PROXY_IPS=127.0.0.1,::1

CORS_ORIGINS=https://goxuetuxing.com,https://www.goxuetuxing.com
UPLOAD_DIR=uploads

# 上传存储：local=服务器本地 uploads 目录；obs=华为云 OBS
STORAGE_DRIVER=obs
OBS_ACCESS_KEY=请填写华为云OBS Access Key Id
OBS_SECRET_KEY=请填写华为云OBS Secret Access Key
OBS_BUCKET=xuetuxing
OBS_REGION=cn-north-4
OBS_ENDPOINT=obs.cn-north-4.myhuaweicloud.com
